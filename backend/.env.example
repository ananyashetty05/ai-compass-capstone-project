# Required for authentication. Generate a long random value for each deployment.
JWT_SECRET=

# Configure one or both real providers. Leave unused providers blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: comma-separated names such as openai, anthropic, google, groq
DISABLED_PROVIDERS=

# Optional routing controls
MAX_ESCALATION_ATTEMPTS=2
QUALITY_ACCEPTANCE_THRESHOLD=0.55
RISK_ACCEPTANCE_THRESHOLD=0.80

# Live Model Pool (apply backend/migrations/20261118_live_model_registry.sql to an approved database first)
LIVE_REGISTRY_ENABLED=false
# Required to call refresh / verification endpoints. Leave blank to keep them disabled.
REGISTRY_ADMIN_TOKEN=
# Autonomous model catalogue. Leave false until migrations/20261121_model_catalog.sql is applied to an approved database.
CATALOG_PERSISTENCE_ENABLED=false
# Bearer secret Vercel Cron presents to GET /api/v1/catalog/cron (Vercel sends it automatically when a CRON_SECRET env var exists).
CRON_SECRET=
REGISTRY_REFRESH_TTL_MINUTES=360
