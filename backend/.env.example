# Required for authentication. Generate a long random value for each deployment.
JWT_SECRET=

# Configure one or both real providers. Leave unused providers blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: comma-separated names such as openai, anthropic, google, groq
DISABLED_PROVIDERS=

# Optional routing controls
MAX_ESCALATION_ATTEMPTS=2
QUALITY_ACCEPTANCE_THRESHOLD=0.55
RISK_ACCEPTANCE_THRESHOLD=0.80
